{
  "name": "react-pdf-gen",
  "version": "1.3.4",
  "private": true,
  "description": "React-PDF + AI: The Builder's Guide to Premium PDF Generation",
  "main": "src/build.tsx",
  "scripts": {
    "build": "tsx src/build.tsx",
    "sync": "tsx scripts/sync-project.ts",
    "export": "bash scripts/export-pages.sh",
    "dev": "tsx watch --include \"src/**/*.ts\" --include \"src/**/*.tsx\" --include \"scripts/sync-project.ts\" --include \"content/chapters/12-markdown-demo.md\" --exclude \"src/registry.ts\" scripts/dev.ts",
    "pipeline": "pnpm build && pnpm export",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "pnpm sync && tsc --noEmit"
  },
  "keywords": [
    "react-pdf",
    "pdf",
    "ai",
    "ebook"
  ],
  "author": "Landon Miles",
  "license": "MIT",
  "homepage": "https://github.com/jlmiles4/react-pdf-gen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlmiles4/react-pdf-gen.git"
  },
  "bugs": {
    "url": "https://github.com/jlmiles4/react-pdf-gen/issues"
  },
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
